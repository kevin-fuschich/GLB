{<script>
  const $ = (id) => document.getElementById(id);
  const qs = (name) => new URLSearchParams(location.search).get(name);

  async function fetchJsonExact(path){
    const url = path + "?v=" + Date.now();
    const res = await fetch(url, { cache: "no-store" });
    if(!res.ok) throw new Error(`HTTP ${res.status} for ${path}`);
    return res.json();
  }

  async function loadGameJson(date, gameKey){
    // Try the "normal" @ filename first
    const p1 = `data/games/${date}/${gameKey}.json`;

    // Fallback: file literally contains %40 in the filename
    const p2 = `data/games/${date}/${gameKey.replaceAll("@","%40")}.json`;

    try{
      return { json: await fetchJsonExact(p1), pathUsed: p1 };
    }catch(e1){
      // Only fallback if it looks like a 404
      if(String(e1.message || e1).includes("HTTP 404")){
        const j2 = await fetchJsonExact(p2);
        return { json: j2, pathUsed: p2 };
      }
      throw e1;
    }
  }

  async function loadTeamsJson(){
    return fetchJsonExact("data/teams/teams.json");
  }

  function pick(obj, keys){
    for(const k of keys){
      if(obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
    }
    return undefined;
  }

  function pickPath(obj, path){
    try{
      return path.split(".").reduce((acc,k)=> (acc && acc[k] !== undefined) ? acc[k] : undefined, obj);
    }catch(e){ return undefined; }
  }

  function toIntOrDash(x){
    const n = Number(x);
    return Number.isFinite(n) ? n : "—";
  }

  function buildTeamsIndex(teamsJson){
    const idx = { bySlug:new Map(), byAbbrev:new Map(), byNameLower:new Map() };
    const list = [];

    if(teamsJson && Array.isArray(teamsJson.teams)) list.push(...teamsJson.teams);
    if(teamsJson && teamsJson.divisions){
      for(const arr of Object.values(teamsJson.divisions)){
        if(Array.isArray(arr)) list.push(...arr);
      }
    }

    for(const t of list){
      const name = t.name || t.team || (t.city && t.nickname ? `${t.city} ${t.nickname}` : undefined);
      const slug = t.slug;
      const abbr = t.abbrev || t.abbr;

      if(name) idx.byNameLower.set(String(name).toLowerCase(), name);
      if(slug && name) idx.bySlug.set(slug, name);
      if(abbr && name) idx.byAbbrev.set(String(abbr).toUpperCase(), name);
    }
    return idx;
  }

  function teamNameFromValue(v, idx){
    if(typeof v === "string"){
      return idx.byNameLower.get(v.toLowerCase()) || v;
    }
    if(v && typeof v === "object"){
      const directName = pick(v, ["name","team","full","display","label"]);
      if(typeof directName === "string"){
        return idx.byNameLower.get(directName.toLowerCase()) || directName;
      }
      const slug = pick(v, ["slug"]);
      if(typeof slug === "string" && idx.bySlug.has(slug)) return idx.bySlug.get(slug);

      const abbr = pick(v, ["abbrev","abbr"]);
      if(typeof abbr === "string" && idx.byAbbrev.has(abbr.toUpperCase())) return idx.byAbbrev.get(abbr.toUpperCase());
    }
    return "—";
  }

  function resolveAwayHome(g){
    const awayTeamVal =
      pick(g, ["away_team","awayTeam","away"]) ||
      pickPath(g, "teams.away") ||
      pickPath(g, "matchup.away") ||
      pickPath(g, "boxscore.teams.away");

    const homeTeamVal =
      pick(g, ["home_team","homeTeam","home"]) ||
      pickPath(g, "teams.home") ||
      pickPath(g, "matchup.home") ||
      pickPath(g, "boxscore.teams.home");

    return { awayTeamVal, homeTeamVal };
  }

  function resolveScores(g){
    const away =
      pick(g, ["away_score","awayScore","away_runs","awayRuns"]) ??
      pickPath(g, "final.away") ??
      pickPath(g, "score.away") ??
      pickPath(g, "linescore.away.r") ??
      pickPath(g, "boxscore.teams.away.runs");

    const home =
      pick(g, ["home_score","homeScore","home_runs","homeRuns"]) ??
      pickPath(g, "final.home") ??
      pickPath(g, "score.home") ??
      pickPath(g, "linescore.home.r") ??
      pickPath(g, "boxscore.teams.home.runs");

    return { away, home };
  }

  (async function main(){
    try{
      const date = qs("date");
      const game = qs("game");

      if(!date || !game){
        $("matchup").textContent = "Missing query string";
        $("metaLine").textContent = "Use: ?date=YYYY-MM-DD&game=away@home";
        $("scoreRows").innerHTML = "<tr><td colspan='2' class='small'>No game selected.</td></tr>";
        return;
      }

      const [{json: g, pathUsed}, teamsJson] = await Promise.all([
        loadGameJson(date, game),
        loadTeamsJson()
      ]);

      const idx = buildTeamsIndex(teamsJson);
      const { awayTeamVal, homeTeamVal } = resolveAwayHome(g);

      const awayName = teamNameFromValue(awayTeamVal, idx);
      const homeName = teamNameFromValue(homeTeamVal, idx);

      const { away, home } = resolveScores(g);

      const status = pick(g, ["status"]) || "Final";
      const attendance = pick(g, ["attendance"]) || "—";

      $("matchup").textContent = `${awayName} @ ${homeName}`;
      $("metaLine").textContent = `${date} · Attendance ${Number(attendance).toLocaleString?.() || attendance} · ${status}`;

      $("scoreRows").innerHTML = `
        <tr><td>${awayName}</td><td>${toIntOrDash(away)}</td></tr>
        <tr><td>${homeName}</td><td>${toIntOrDash(home)}</td></tr>
      `;

      // Optional: show which file was used (helps sanity)
      const dbg = document.getElementById("debugLine");
      if(dbg) dbg.textContent = "Loaded from: " + pathUsed;

    }catch(err){
      $("matchup").textContent = "Load failed";
      $("metaLine").textContent = err.message || String(err);
      $("scoreRows").innerHTML = "<tr><td colspan='2' class='small'>Could not load game JSON.</td></tr>";
      console.error(err);
    }
  })();
</script>
